{
  "name": "bg3-video-hud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.8.0" },
  "scripts": {
    "check": "node tools/check.mjs",
    "test": "node --test --test-isolation=none tests/*.test.js",
    "test:browser": "node tools/browser-test.mjs",
    "test:deploy": "python3 -m unittest discover -s tests -p 'test_deploy.py' -v",
    "package": "npm run check && python3 tools/package.py"
  }
}
