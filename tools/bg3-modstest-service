#!/bin/sh
# Install this file root-owned at /usr/local/sbin/bg3-modstest-service.
# A workflow must never install or overwrite its own privileged helper.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
test "$#" -eq 1
case "$1" in
  start|stop) exec /usr/bin/systemctl "$1" foundry-modstest.service ;;
  check)
    attempt=0
    while test "$attempt" -lt 30; do
      if /usr/bin/systemctl is-active --quiet foundry-modstest.service &&
         /usr/bin/curl --fail --silent --max-time 2 --noproxy 127.0.0.1 http://127.0.0.1:30001/join |
         /usr/bin/grep -q '<title>ModsTest</title>'; then
        exit 0
      fi
      attempt=$((attempt + 1))
      /usr/bin/sleep 1
    done
    exit 1
    ;;
  *) exit 64 ;;
esac
